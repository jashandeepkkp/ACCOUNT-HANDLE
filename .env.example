# Angel One SmartAPI — server-side only. Never prefix these with NEXT_PUBLIC_.
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=

# Fixed outbound IP assigned to the production hosting service.
ANGELONE_STATIC_IP=
# Set true only after the same IP is registered/whitelisted in Angel One SmartAPI.
ANGELONE_STATIC_IP_REGISTERED=false

# Set true only after account ownership and broker API permissions are verified.
ANGELONE_ACCOUNT_AUTHORIZED=false

# Safety: live execution remains hard-disabled in application code regardless of env.
